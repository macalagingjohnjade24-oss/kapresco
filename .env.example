# Supabase project credentials — Project Settings → API
# Copy this file to `.env` and fill in the real values.
# Only VITE_* variables are exposed to the browser, and only the anon (public)
# key belongs here. NEVER put the service_role key in this file.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
